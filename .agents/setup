#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

log_step() {
  printf '\n==> %s\n' "$1"
}

install_system_packages() {
  local packages=(
    build-essential
    clang
    cmake
    curl
    libasound2-dev
    libayatana-appindicator3-dev
    libclang-dev
    libgtk-3-dev
    librsvg2-dev
    libssl-dev
    libwebkit2gtk-4.1-dev
    patchelf
    pkg-config
  )
  local missing=()
  local package

  for package in "${packages[@]}"; do
    if ! dpkg-query --show --showformat='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]})); then
    log_step "Installing system packages"
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "${missing[@]}"
  fi
}

install_rust() {
  if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    log_step "Installing Rust"
    curl --proto '=https' --tlsv1.2 --silent --show-error --fail https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable
  fi

  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
  if ! rustup toolchain list | grep -q '^stable'; then
    rustup toolchain install stable --profile minimal --component clippy,rustfmt
    rustup default stable
  fi
  if ! rustup component list --installed | grep -q '^clippy'; then
    rustup component add clippy
  fi
  if ! rustup component list --installed | grep -q '^rustfmt'; then
    rustup component add rustfmt
  fi
}

install_bun() {
  if command -v bun >/dev/null 2>&1 && [ "$(bun --version)" = "1.4.4" ]; then
    return
  fi

  log_step "Installing Bun 1.4.4"
  curl --fail --location --silent --show-error https://bun.sh/install | bash -s "bun-v1.4.4"
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  export PATH="$BUN_INSTALL/bin:$PATH"
}

main() {
  install_system_packages
  install_rust
  install_bun

  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  export PATH="$BUN_INSTALL/bin:$HOME/.cargo/bin:$PATH"

  log_step "Installing frontend dependencies"
  bun install --frozen-lockfile

  log_step "Fetching Rust dependencies"
  cargo fetch --manifest-path src-tauri/Cargo.toml
}

main "$@"
