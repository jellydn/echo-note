#!/usr/bin/env bash
set -euo pipefail

log_step() {
  printf '\n==> %s\n' "$1"
}

install_system_packages() {
  local packages=(
    build-essential
    cmake
    curl
    clang
    libasound2-dev
    libayatana-appindicator3-dev
    libgtk-3-dev
    libwebkit2gtk-4.1-dev
    patchelf
    pkg-config
  )
  local missing=()
  local package

  for package in "${packages[@]}"; do
    if ! dpkg-query --show --showformat='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]})); then
    log_step "Installing system packages"
    sudo apt-get update
    sudo apt-get install --yes --no-install-recommends "${missing[@]}"
  fi
}

install_rust() {
  if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    log_step "Installing Rust"
    curl --proto '=https' --tlsv1.2 --silent --show-error --fail https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable
  fi

  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
  rustup toolchain install stable --profile minimal
  rustup component add clippy rustfmt --toolchain stable
}

install_bun() {
  if ! command -v bun >/dev/null 2>&1; then
    log_step "Installing Bun"
    curl --fail --location --silent --show-error https://bun.sh/install | bash
  fi
}

main() {
  install_system_packages
  install_rust
  install_bun

  log_step "Installing frontend dependencies"
  bun install --frozen-lockfile

  log_step "Fetching Rust dependencies"
  cargo fetch --manifest-path src-tauri/Cargo.toml
}

main "$@"
