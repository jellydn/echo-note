{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 4am on monday"],
		"automerge": true
	},
	"packageRules": [
		{
			"matchManagers": ["npm", "bun"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Bun/npm minor and patch updates",
			"groupSlug": "bun-npm-minor-patch"
		},
		{
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Cargo minor and patch updates",
			"groupSlug": "cargo-minor-patch"
		}
	]
}
